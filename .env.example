# Copy to .env and fill in. docker compose reads this file automatically.

# ---------- required ----------
# Your login password (single owner)
APP_PASSWORD=
# Long random string for session tokens:  openssl rand -base64 48
JWT_SECRET=
# 32 random bytes, base64 — encrypts platform tokens in the DB:  openssl rand -base64 32
# Keep it safe: changing it means reconnecting every platform.
CREDENTIALS_KEY=

# ---------- YouTube ----------
# Data API v3 key for search (Google Cloud Console > APIs & Services > Credentials)
YOUTUBE_API_KEY=
# Only for the usage meter in Discover (raise it if Google granted you more quota).
YOUTUBE_DAILY_QUOTA=10000
# Identical searches within this many seconds are served from cache (no quota).
YOUTUBE_CACHE_TTL_SECONDS=3600
# OAuth client for *publishing* to YouTube (can also be entered in Settings > Platforms)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# If downloads fail with "confirm you're not a bot": export youtube.com cookies (Netscape format)
# to ./secrets/youtube-cookies.txt and set:
# YTDLP_COOKIES_FILE=/secrets/youtube-cookies.txt

# ---------- AI ----------
# heuristic (no key) or llm (OpenAI / Azure OpenAI)
CLIP_PLANNER=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
WHISPER_MODEL=base

# ---------- testing ----------
# true = simulate posting (no platform API calls)
PUBLISH_DRY_RUN=false
# Host port for the web UI
WEB_PORT=3000
