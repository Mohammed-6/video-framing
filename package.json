{
  "name": "clipforge",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build": "pnpm -r --filter ./packages/** run build && pnpm -r --filter ./apps/** run build",
    "dev": "pnpm --filter @clipforge/contracts build && pnpm -r --parallel --filter ./apps/** run dev",
    "typecheck": "pnpm --filter @clipforge/contracts build && pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @clipforge/api run db:migrate"
  }
}
